# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated reels (scripts/reels)
/reels-out/
# Piper TTS voice models (~60 MB each) — downloaded, never committed.
# Fetch with: npm run reels:voices
/scripts/reels/voices/
# synthesized-narration cache
/scripts/reels/.tmp/

# 3D prototype (Blender) - large binaries, regenerate with scripts/blender/render.sh
/assets/3d/
/out-3d/

# python bytecode
__pycache__/
